# Configure SMTP para habilitar o envio real de e-mail.
# Sem essas configuracoes, o PDF e o QR Code ainda sao gerados.
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USERNAME=usuario@exemplo.com
SMTP_PASSWORD=sua_senha_ou_token
SMTP_ENCRYPTION=tls
SMTP_FROM=usuario@exemplo.com
SMTP_FROM_NAME=Sistema de Documentos
